# ─────────────────────────────────────────────────────────────────────────────
# DevForge AI — Configuration Template
# Copy this file to application.yml and fill in your real values.
# application.yml is gitignored so secrets are never committed.
# ─────────────────────────────────────────────────────────────────────────────

server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/devforge_ai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_MYSQL_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect

  session:
    store-type: none

  servlet:
    session:
      cookie:
        same-site: lax
        http-only: true
        secure: false   # set to true in production

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: YOUR_GOOGLE_CLIENT_ID
            client-secret: YOUR_GOOGLE_CLIENT_SECRET
            scope:
              - email
              - profile
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
        provider:
          google:
            authorization-uri: https://accounts.google.com/o/oauth2/v2/auth
            token-uri: https://oauth2.googleapis.com/token
            user-info-uri: https://www.googleapis.com/oauth2/v3/userinfo
            user-name-attribute: sub

jwt:
  secret: YOUR_JWT_SECRET_MIN_32_CHARS_LONG
  expiration: 86400000   # 24 hours in ms

app:
  oauth2:
    redirect-uri: http://localhost:5173/oauth2/redirect
    failure-uri:  http://localhost:5173/oauth2/error

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter AI Keys — get free keys at https://openrouter.ai
# Add as many keys as you want — round-robin rotation is automatic
# ─────────────────────────────────────────────────────────────────────────────
openrouter:
  base-url: https://openrouter.ai/api/v1/chat/completions
  timeout-seconds: 60
  max-retries: 3
  memory-size: 20
  keys:
    - YOUR_OPENROUTER_KEY_1
    - YOUR_OPENROUTER_KEY_2   # optional extra keys

  models:
    architecture:  "deepseek/deepseek-r1"
    backend:       "openai/gpt-4.1"
    frontend:      "openai/gpt-4.1"
    debug:         "anthropic/claude-sonnet-4-5"
    documentation: "google/gemini-2.5-pro"
    database:      "deepseek/deepseek-r1"
    security:      "anthropic/claude-sonnet-4-5"
    planning:      "deepseek/deepseek-r1"
    general:       "openai/gpt-4.1"

---
spring:
  config:
    activate:
      on-profile: prod
  servlet:
    session:
      cookie:
        secure: true
server:
  port: 8080
